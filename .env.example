# App
APP_ENV=development
KITCHEN_TOKEN=change-me-to-a-random-string

# Email (Resend)
RESEND_API_KEY=re_xxxxxxxxxxxx
FROM_EMAIL=orders@yourdomain.com

# Printer (Epson network printer)
PRINTER_IP=192.168.1.100
PRINTER_PORT=9100
PRINTER_ENABLED=false

# Database: SQLite locally; a Neon Postgres URL on Vercel
# (postgresql://user:pass@host/db?sslmode=require is accepted as-is).
DATABASE_URL=sqlite:///./orders.db

# Restaurant Android app
# The app logs in with KITCHEN_TOKEN as a Bearer token.
RESTAURANT_TIMEZONE=Europe/Amsterdam
# Firebase service-account JSON (file path or inline JSON) for push notifications.
# Leave empty to disable push; the app still polls while in the foreground.
FIREBASE_CREDENTIALS=
